rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // GLOBAL DEFAULT DENY CATCH-ALL
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // REUSABLE SECURITY PRIMITIVES & HELPER FUNCTIONS
    // -------------------------------------------------------------------------

    // Validate if document ID is highly secure and prevents injection attacks
    function isValidId(id) {
      return id is string 
        && id.size() >= 1 
        && id.size() <= 128 
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Capture state references
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Authenticated state check
    function isSignedIn() {
      return request.auth != null;
    }

    // Verify if current user owns the target resource
    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // Check if user's registered email verification state is valid
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Check for global Admin access based on explicit firestore path record checks
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'shuvokuakata27@gmail.com' && request.auth.token.email_verified == true)
      );
    }


    // -------------------------------------------------------------------------
    // ENTITY VALIDATION SCHEMAS
    // -------------------------------------------------------------------------

    // 1. Customer Verification Helper
    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'createdAt'])
        && data.keys().size() <= 5
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.createdAt is string;
    }

    // 2. Product Verification Helper
    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'category', 'image', 'vendorName', 'stock'])
        && data.id is string
        && data.name is string && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.category is string && data.category.size() <= 50
        && data.image is string && data.image.size() <= 512
        && data.vendorName is string && data.vendorName.size() <= 100
        && data.stock is number && data.stock >= 0;
    }

    // 3. Order Verification Helper
    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerName', 'customerPhone', 'shippingAddress', 'items', 'totalAmount', 'status', 'paymentStatus', 'paymentMethod', 'deliveryType', 'createdAt'])
        && data.id is string
        && data.customerName is string && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() <= 15
        && data.shippingAddress is string && data.shippingAddress.size() <= 500
        && data.items is list
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status is string && data.status in ['pending', 'processing', 'shipped', 'delivered']
        && data.paymentStatus is string && data.paymentStatus in ['pending', 'paid', 'failed']
        && data.paymentMethod is string && data.paymentMethod in ['bkash', 'nagad', 'card', 'cod']
        && data.deliveryType is string && data.deliveryType in ['standard', 'express']
        && data.createdAt is string;
    }

    // 4. Notification Verification Helper
    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'type', 'isRead', 'createdAt'])
        && data.id is string
        && data.title is string && data.title.size() <= 150
        && data.message is string && data.message.size() <= 1000
        && data.type is string && data.type in ['order', 'offer', 'system']
        && data.isRead is bool
        && data.createdAt is string;
    }

    // 5. SupportMessage Verification Helper
    function isValidSupportMessage(data) {
      return data.keys().hasAll(['id', 'sender', 'text', 'timestamp'])
        && data.id is string
        && data.sender is string && data.sender in ['user', 'bot', 'agent']
        && data.text is string && data.text.size() <= 1000
        && data.timestamp is string;
    }

    // 6. Settings Verification Helper
    function isValidSettings(data) {
      return data.keys().hasAll(['siteName', 'siteTagline', 'heroTitle', 'enableAiChat', 'enableSupportChat', 'enableOrderTracker'])
        && data.siteName is string && data.siteName.size() <= 50
        && data.siteTagline is string
        && data.heroTitle is string
        && data.enableAiChat is bool
        && data.enableSupportChat is bool
        && data.enableOrderTracker is bool;
    }


    // -------------------------------------------------------------------------
    // COLLECTION MATCH RULES
    // -------------------------------------------------------------------------

    // CUSTOMERS COLLECTION
    match /customers/{customerId} {
      allow get: if isSignedIn() && (customerId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() 
        && customerId == request.auth.uid 
        && isValidCustomer(incoming());

      allow update: if isSignedIn() 
        && customerId == request.auth.uid 
        && isValidCustomer(incoming())
        && incoming().createdAt == existing().createdAt; // createdAt is immortal
        
      allow delete: if isAdmin();
    }

    // PRODUCTS COLLECTION
    match /products/{productId} {
      // Anyone can explore products (unauthenticated read is permissible for catalogues)
      allow get, list: if true;

      allow create: if (isSignedIn() && isValidProduct(incoming())) || isAdmin();
      
      allow update: if (isSignedIn() && isValidProduct(incoming())) || isAdmin();

      allow delete: if isAdmin() || (isSignedIn() && existing().vendorId == request.auth.uid);
    }

    // ORDERS COLLECTION
    match /orders/{orderId} {
      // Users can see their own orders, Admins can inspect all orders
      allow get: if isSignedIn() && (resource.data.customerPhone == request.auth.token.phone_number || isAdmin());
      allow list: if isSignedIn() && (resource.data.customerPhone == request.auth.token.phone_number || isAdmin());

      allow create: if isSignedIn() && isValidOrder(incoming());

      // Only Admin or specific order actions are authorized
      allow update: if (isSignedIn() && isValidOrder(incoming()) && (
        // Action: Change Shipment Status (Restricted Field Mod)
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) ||
        // Action: Pay Settlement
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus'])
      )) || isAdmin();

      allow delete: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow read: if true; // Public broadcasts, alerts, and offer notifications

      allow create: if isAdmin();
      
      allow update: if (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])) || isAdmin();

      allow delete: if isAdmin();
    }

    // SUPPORT MESSAGES COLLECTION
    match /messages/{messageId} {
      // Active messaging access
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSupportMessage(incoming());
      allow update, delete: if isAdmin();
    }

    // SITE SETTINGS DOCUMENT
    match /settings/{settingsDocId} {
      allow read: if true; // Anyone can read configurations to render site custom visuals

      allow write: if isAdmin();
    }
  }
}
